# Copy to .env for local development. Never commit .env or real secrets.
# Every variable is validated at startup (src/config/env.js); the app refuses to start on bad config.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Reverse-proxy / load-balancer hops in front of the app (0 when running directly).
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

JSON_BODY_LIMIT=100kb

# --- PostgreSQL + PostGIS -----------------------------------------------------
# Matches docker-compose.yml. For managed databases append ?sslmode=require (or verify-full).
DATABASE_URL=postgres://navora:navora_dev_password@localhost:5433/navora
DB_POOL_MIN=0
# Keep (instances x DB_POOL_MAX) below the database's max_connections.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Optional: a separate PostGIS database used only by the integration tests.
# Its contents are wiped by the tests. Leave unset to skip database tests.
# TEST_DATABASE_URL=postgres://navora:navora_dev_password@localhost:5433/navora_test

# --- HTTP / lifecycle ----------------------------------------------------------
# Must be greater than the load balancer's idle timeout.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
READINESS_TIMEOUT_MS=2000
# Production: ~5000 so the load balancer can stop routing before the server closes.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=25000

# --- Authentication --------------------------------------------------------------
# REQUIRED. At least 32 characters; identical on every instance. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_ISSUER=navora-api
JWT_AUDIENCE=navora-app
REFRESH_TOKEN_TTL_DAYS=30

# --- Added in later phases (not used yet) ---------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# MAP_PROVIDER=
# MAP_API_KEY=

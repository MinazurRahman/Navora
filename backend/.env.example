# Copy to .env for local development. Never commit .env or real secrets.
# Every variable is validated at startup (src/config/env.js); the app refuses to start on bad config.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Reverse-proxy / load-balancer hops in front of the app (0 when running directly).
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

JSON_BODY_LIMIT=100kb

# --- PostgreSQL + PostGIS -----------------------------------------------------
# Matches docker-compose.yml. For managed databases append ?sslmode=require (or verify-full).
DATABASE_URL=postgres://navora:navora_dev_password@localhost:5433/navora
DB_POOL_MIN=0
# Keep (instances x DB_POOL_MAX) below the database's max_connections.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Optional: a separate PostGIS database used only by the integration tests.
# Its contents are wiped by the tests. Leave unset to skip database tests.
# TEST_DATABASE_URL=postgres://navora:navora_dev_password@localhost:5433/navora_test

# --- HTTP / lifecycle ----------------------------------------------------------
# Must be greater than the load balancer's idle timeout.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
READINESS_TIMEOUT_MS=2000
# Production: ~5000 so the load balancer can stop routing before the server closes.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=25000

# --- Authentication --------------------------------------------------------------
# REQUIRED. At least 32 characters; identical on every instance. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_ISSUER=navora-api
JWT_AUDIENCE=navora-app
REFRESH_TOKEN_TTL_DAYS=30

# --- Upstash Redis (rate limiting + cache) -------------------------------------------
# REQUIRED. From the Upstash console → your database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Routing / maps -----------------------------------------------------------------
# estimate         = distance-based estimates, no external calls (default)
# openrouteservice = real road travel times; free key at https://openrouteservice.org
MAP_PROVIDER=estimate
MAP_API_KEY=
MAP_TIMEOUT_MS=5000
# Total routing-provider time per request; then (or after a provider outage) flagged estimates.
MAP_REQUEST_BUDGET_MS=15000
# On provider failure: true = continue with clearly flagged estimates; false = return 503.
MAP_FALLBACK_TO_ESTIMATE=true

# --- AI assistant (optional) -----------------------------------------------------------
# Off by default. When on, requests go to a local/self-hosted Ollama (https://ollama.com):
#   ollama pull llama3.2:3b
# Ollama has no authentication: keep it on localhost or a private network, never public.
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Ollama's cloud API instead of a local server: OLLAMA_BASE_URL=https://ollama.com, a cloud model such as
# OLLAMA_MODEL=gemma4:31b, and a key from https://ollama.com/settings/keys (secret; https only).
# Trip details are then sent to Ollama's cloud.
OLLAMA_API_KEY=
# Must stay below HTTP_KEEP_ALIVE_TIMEOUT_MS and the load balancer's idle timeout.
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=600
# Model context window (prompt + answer); prompts are trimmed to fit. AI_MAX_OUTPUT_TOKENS
# must be at most half of it. Larger windows need more memory on the Ollama host.
AI_CONTEXT_WINDOW_TOKENS=8192
# AI calls one API instance runs at once (more get 503); match the Ollama host's capacity.
AI_MAX_CONCURRENT=2

# --- Mail and links ---
# The frontend's origin; password reset links point there.
APP_BASE_URL=http://localhost:5173
# log = reset links are written to the server log instead of being mailed (development).
MAIL_PROVIDER=log

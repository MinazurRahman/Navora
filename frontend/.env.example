# Base URL of the NAVORA API, including the version prefix. No trailing slash.
# The backend's CORS_ORIGINS must list this app's origin (http://localhost:5173 in development).
VITE_API_BASE_URL=http://localhost:3000/api/v1
# OAuth client ID for "Sign in with Google" (same value as the backend's GOOGLE_CLIENT_ID).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

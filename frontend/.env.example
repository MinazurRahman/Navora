# Copy to .env.local if you need to change these. Never commit real secrets (there are none here).

# Where the Vite dev server forwards /api requests (your local backend).
VITE_DEV_BACKEND_URL=http://localhost:3000

# Leave empty in development (requests go through the Vite proxy above).
# For a production build served from a different host than the API, set the API origin,
# e.g. https://api.navora.example — and add the frontend's origin to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=

# Map tiles. The default is OpenStreetMap's public tile server, which is fine for development
# but has a usage policy (https://operations.osmfoundation.org/policies/tiles/). Use a tile
# provider for production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
